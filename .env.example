# ============================================================
# Operation Manager - environment template
# Copy to .env and fill in real values. Commit this file, not .env.
# ============================================================

# ---------- browser-exposed (required by the app) ----------
# Project Settings > API. These are the ONLY two that belong in Vercel
# for the client. The anon key is public by design; RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- server-only ----------
# Bypasses Row Level Security. Used by occurrence generation and the seed
# importer, which act as the system rather than as a user.
# Set in Vercel as a Sensitive variable. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the Vercel Cron occurrence generator.
# Vercel sends it as `Authorization: Bearer <value>`.
CRON_SECRET=

# ---------- local CLI only (do NOT add to Vercel) ----------
# Personal Access Token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref from https://supabase.com/dashboard/project/<THIS_PART>
SUPABASE_PROJECT_REF=
# Database password (Project Settings > Database)
SUPABASE_DB_PASSWORD=
# Mirrors NEXT_PUBLIC_SUPABASE_URL; used by the seed importer.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: override the workbook path used by `npm run import:extract`
SEED_WORKBOOK=

# Orders module go-live (YYYY-MM-DD). Earlier history stays in Excel.
NEXT_PUBLIC_ORDERS_GO_LIVE=

# ---------- Web Push ----------
# Generate a keypair with:  npx web-push generate-vapid-keys
# The public key ships to browsers; the private key signs push requests.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address required by the Web Push spec.
VAPID_SUBJECT=mailto:you@example.com
